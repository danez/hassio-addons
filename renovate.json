{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "gitIgnoredAuthors": ["120286224+danez-bot@users.noreply.github.com"],
  "timezone": "Europe/Berlin",
  "platformAutomerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "rebaseWhen": "behind-base-branch",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    ":configMigration",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "matchFileNames": ["**/Dockerfile", "**/build.yaml"],
      "semanticCommitType": "fix"
    },
    {
      "matchFileNames": ["affine/Dockerfile"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["node"],
      "allowedVersions": "/^22\\./"
    },
    {
      "matchDatasources": ["apk"],
      "registryUrls": [
        "https://dl-cdn.alpinelinux.org/alpine?branch=v3.24&components=main,community&arch=aarch64"
      ]
    },
    {
      "matchFileNames": ["affine/**"],
      "groupName": "affine dependencies",
      "groupSlug": "affine",
      "groupSingleUpdates": true,
      "separateMajorMinor": false,
      "prBodyColumns": ["Package", "Update", "Change"],
      "schedule": ["* 0-5 * * *"]
    },
    {
      "matchFileNames": ["resticprofile-backup/**"],
      "groupName": "resticprofile-backup dependencies",
      "groupSlug": "resticprofile-backup",
      "groupSingleUpdates": true,
      "separateMajorMinor": false,
      "prBodyColumns": ["Package", "Update", "Change"],
      "schedule": ["* 0-5 * * *"]
    },
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "pinDigest"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pinned apk add packages in Dockerfiles",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "apk add[^\\n]*\\\\\\n(?:[ \\t]+[^\\n]*\\\\\\n)*[ \\t]+[^\\n]+",
        "(?<depName>[a-zA-Z0-9][a-zA-Z0-9+_.-]*)=(?<currentValue>[^\\s\\\\]+)"
      ],
      "datasourceTemplate": "apk"
    },
    {
      "customType": "regex",
      "description": "Update _VERSION variables in Dockerfiles",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?)(?: depName=(?<depName>.+?))? packageName=(?<packageName>.+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s(?:ENV|ARG) .+?_VERSION=(?<currentValue>.+?)\\s"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ]
}
